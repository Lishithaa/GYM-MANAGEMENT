# Frontend dev server port (CRA reads PORT).
# If 3000 is busy, CRA uses 3001, 3002, … — add that URL to backend CORS_ORIGINS.
PORT=3000

# FastAPI base URL — no trailing slash, no /api suffix. Restart `yarn start` after edits.
# Use localhost if the app is opened as http://localhost:* (matches browser origin patterns).
REACT_APP_BACKEND_URL=http://localhost:8000

# Leave unset for normal local dev. Setting this to 443 breaks the dev WebSocket.
# WDS_SOCKET_PORT=

ENABLE_HEALTH_CHECK=false